# PostgreSQL (Neon, Supabase, Vercel Postgres o altro provider)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/soagri?sslmode=require"
# Stringa casuale lunga almeno 32 caratteri
AUTH_SECRET="sostituire-con-una-stringa-casuale-lunga"
# Credenziali bootstrap, usate dallo script di seed
ADMIN_EMAIL="admin@soagri.local"
ADMIN_PASSWORD="cambia-questa-password"
# Web Push (opzionale nella V1)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:amministrazione@example.it"
